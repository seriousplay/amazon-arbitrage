[Unit]
Description=Amazon Arbitrage Scout - FastAPI App
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/apps/amazon-arbitrage
Environment=PATH=/root/apps/amazon-arbitrage/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/apps/amazon-arbitrage/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
