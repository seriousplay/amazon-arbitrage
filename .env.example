# Amazon Pet Arbitrage Scout - 环境变量配置
# 复制为 .env 并修改

# 应用配置
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=*

# 数据库
DATABASE_URL=sqlite+aiosqlite:///data/arbitrage.db

# Playwright
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_TIMEOUT=30000
BROWSER_CONCURRENCY=2

# 爬虫延迟（秒）
REQUEST_DELAY_MIN=2.0
REQUEST_DELAY_MAX=5.0

# 爬取规模
AMAZON_BSR_PAGES=1
ALIBABA_MAX_PAGES=3

# 滑块破解
SLIDER_MAX_RETRIES=3
SLIDER_USE_VISION=true
CAPTCHA_DEBUG=true

# 评分阈值
MIN_SCORE_FOR_RECOMMENDATION=60

# 并发
MAX_WORKERS=2
TASK_TIMEOUT=600
